From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
Subject: [PATCH] Allow runtime Telegram API credentials via environment

---
diff --git a/Telegram/SourceFiles/config.h b/Telegram/SourceFiles/config.h
--- a/Telegram/SourceFiles/config.h
+++ b/Telegram/SourceFiles/config.h
@@ -10,2 +10,5 @@
 #include "settings.h"
 
+#include <QtCore/QByteArray>
+#include <QtCore/QString>
+
@@ -47,1 +47,1 @@
-constexpr auto ApiId = TDESKTOP_API_ID;
+constexpr auto BuiltInApiId = TDESKTOP_API_ID;
@@ -48,1 +48,1 @@
-constexpr auto ApiHash = QT_STRINGIFY(TDESKTOP_API_HASH);
+constexpr auto BuiltInApiHash = QT_STRINGIFY(TDESKTOP_API_HASH);
@@ -69,1 +69,1 @@
-constexpr auto ApiId = 17349;
+constexpr auto BuiltInApiId = 17349;
@@ -70,1 +70,1 @@
-constexpr auto ApiHash = "344583e45741c457fe1862106095a5eb";
+constexpr auto BuiltInApiHash = "344583e45741c457fe1862106095a5eb";
@@ -72,2 +72,42 @@
 #endif // TDESKTOP_API_ID && TDESKTOP_API_HASH
 
+struct TelegramApiCredentials {
+	int id = 0;
+	QString hash;
+};
+
+inline const TelegramApiCredentials &CurrentTelegramApiCredentials() {
+	static const auto credentials = [] {
+		const auto idText = qgetenv("TDESKTOP_API_ID");
+		const auto hashBytes = qgetenv("TDESKTOP_API_HASH");
+		auto idOk = false;
+		const auto id = idText.toInt(&idOk);
+		auto hashOk = (hashBytes.size() == 32);
+		for (const auto ch : hashBytes) {
+			hashOk = hashOk && (
+				(ch >= '0' && ch <= '9')
+				|| (ch >= 'a' && ch <= 'f')
+				|| (ch >= 'A' && ch <= 'F'));
+		}
+		if (idOk && id > 0 && hashOk) {
+			return TelegramApiCredentials{
+				id,
+				QString::fromLatin1(hashBytes.constData(), hashBytes.size()).toLower(),
+			};
+		}
+		return TelegramApiCredentials{
+			BuiltInApiId,
+			QString::fromLatin1(BuiltInApiHash),
+		};
+	}();
+	return credentials;
+}
+
+inline int ApiId() {
+	return CurrentTelegramApiCredentials().id;
+}
+
+inline QString ApiHash() {
+	return CurrentTelegramApiCredentials().hash;
+}
+
