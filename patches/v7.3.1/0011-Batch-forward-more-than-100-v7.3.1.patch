From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
Subject: [PATCH] Forward large selections in server-sized batches

---
diff --git a/Telegram/SourceFiles/history/history_inner_widget.cpp b/Telegram/SourceFiles/history/history_inner_widget.cpp
--- a/Telegram/SourceFiles/history/history_inner_widget.cpp
+++ b/Telegram/SourceFiles/history/history_inner_widget.cpp
@@ -139,8 +139,9 @@
 namespace {
 
 constexpr auto kScrollDateHideTimeout = 1000;
 constexpr auto kScrollDateHideOnDayCrossingTimeout = crl::time(3000);
 constexpr auto kUnloadHeavyPartsPages = 2;
 constexpr auto kClearUserpicsAfter = 50;
+constexpr auto kMaxBulkForwardSelectionItems = 1000;
 
 // Helper binary search for an item in a list that is not completely
@@ -3247,8 +3248,8 @@
 				const auto start = (topToBottom ? nearestItem : toItem);
 				const auto end = (topToBottom ? toItem : nearestItem);
-				const auto left = MaxSelectedItems
+				const auto left = kMaxBulkForwardSelectionItems
 					- selectedState.count
 					+ (topToBottom ? 0 : 1);
 				if (collectBetween(start, end, left).empty()) {
 					return;
 				}
@@ -5232,15 +5233,18 @@
 auto HistoryInner::getSelectionState() const
 -> HistoryView::TopBarWidget::SelectedState {
 	auto result = HistoryView::TopBarWidget::SelectedState {};
 	for (const auto &item : _selected) {
 		++result.count;
 		if (item->isEphemeral() || item->canDelete()) {
 			++result.canDeleteCount;
 		}
 		if (item->allowsForward()) {
 			++result.canForwardCount;
 		}
 	}
+	if (result.count > MaxSelectedItems) {
+		result.canDeleteCount = 0;
+	}
 	result.textSelected = hasSelectedText()
 		&& !_selectedTextSelection.empty();
 	return result;
@@ -6011,7 +6015,7 @@
 	if (add
 		&& goodForSelection(toItems, item, total)
-		&& total <= MaxSelectedItems) {
+		&& total <= kMaxBulkForwardSelectionItems) {
 		addToSelection(toItems, item);
 	} else {
 		removeFromSelection(toItems, item);
 	}
@@ -6035,9 +6039,9 @@
 		for (const auto &other : group->items) {
 			if (!goodForSelection(toItems, other, total)) {
 				return false;
 			}
 		}
-		return (total <= MaxSelectedItems);
+		return (total <= kMaxBulkForwardSelectionItems);
 	}();
 	if (action == SelectAction::Select && canSelect) {
 		for (const auto &other : group->items) {
@@ -6308,1 +6312,1 @@
-			if (toItems->size() >= MaxSelectedItems) break;
+			if (toItems->size() >= kMaxBulkForwardSelectionItems) break;
diff --git a/Telegram/SourceFiles/apiwrap.cpp b/Telegram/SourceFiles/apiwrap.cpp
--- a/Telegram/SourceFiles/apiwrap.cpp
+++ b/Telegram/SourceFiles/apiwrap.cpp
@@ -4112,5 +4112,8 @@
+	const auto maxForwardedPerRequest = std::max(
+		1,
+		_session->serverConfig().forwardedCountMax);
 	ids.reserve(count);
 	randomIds.reserve(count);
 	for (const auto &range : collected) {
 		fromEphemeral = range.fromEphemeral;
 		for (const auto &item : range.items) {
@@ -4144,10 +4147,22 @@
 			const auto newFrom = item->history()->peer;
 			if (forwardFrom != newFrom) {
 				sendAccumulated();
 				forwardFrom = newFrom;
 			}
+			if (const auto group = _session->data().groups().find(item);
+				group
+				&& (group->items.front() == item)
+				&& (int(group->items.size()) <= maxForwardedPerRequest)
+				&& !ids.isEmpty()
+				&& (int(ids.size()) + int(group->items.size())
+					> maxForwardedPerRequest)) {
+				sendAccumulated();
+			}
 			ids.push_back(range.fromEphemeral
 				? MTP_int(_session->ephemeralMessages().lookupId(item))
 				: MTP_int(item->id));
 			randomIds.push_back(MTP_long(randomId));
+			if (int(ids.size()) >= maxForwardedPerRequest) {
+				sendAccumulated();
+			}
 		}
diff --git a/Telegram/SourceFiles/boxes/share_box.cpp b/Telegram/SourceFiles/boxes/share_box.cpp
--- a/Telegram/SourceFiles/boxes/share_box.cpp
+++ b/Telegram/SourceFiles/boxes/share_box.cpp
@@ -58,3 +58,4 @@
 #include "data/data_changes.h"
 #include "main/main_session.h"
+#include "mtproto/mtproto_config.h"
 #include "core/application.h"
@@ -1878,6 +1878,9 @@
 		const auto ranges = CollectForwardRanges(items);
 		if (ranges.empty()) {
 			return;
 		}
+		const auto maxForwardedPerRequest = std::max(
+			1,
+			history->session().serverConfig().forwardedCountMax);
 		auto &api = history->session().api();
 		auto &histories = history->owner().histories();
@@ -1968,86 +1971,115 @@
-			for (const auto &range : ranges) {
-				const auto mtpMsgIds = ForwardRangeIds(
-					&history->session(),
-					range);
-				if (mtpMsgIds.isEmpty()) {
-					continue;
-				}
-				const auto msgCount = int(mtpMsgIds.size());
-				const auto starsPaid = std::min(
-					options.starsApproved,
-					msgCount * peer->starsPerMessageChecked());
-				if (starsPaid) {
-					options.starsApproved -= starsPaid;
-				}
-				const auto sendFlags = commonSendFlags
-					| (ShouldSendSilent(peer, options)
-						? Flag::f_silent
-						: Flag(0))
-					| (options.shortcutId
-						? Flag::f_quick_reply_shortcut
-						: Flag(0))
-					| (starsPaid ? Flag::f_allow_paid_stars : Flag())
-					| (sublistPeer ? Flag::f_reply_to : Flag())
-					| (options.suggest ? Flag::f_suggested_post : Flag())
-					| (options.effectId ? Flag::f_effect : Flag())
-					| (range.fromEphemeral
-						? Flag::f_from_ephemeral
-						: Flag(0));
-				auto buildMessage = [=](
-						not_null<History*> history,
-						FullReplyTo replyTo)
-					-> Data::Histories::PreparedMessage {
-					const auto kGeneralId
-						= Data::ForumTopic::kGeneralId;
-					const auto realTopMsgId
-						= (replyTo.topicRootId == kGeneralId)
-						? MsgId(0)
-						: replyTo.topicRootId;
-					auto flags = sendFlags;
-					if (realTopMsgId) {
-						flags |= Flag::f_top_msg_id;
-					} else {
-						flags &= ~Flag::f_top_msg_id;
-					}
-					auto randoms = QVector<MTPlong>(msgCount);
-					for (auto &value : randoms) {
-						value = base::RandomValue<MTPlong>();
-					}
-					return MTPmessages_ForwardMessages(
-						MTP_flags(flags),
-						fromPeer->input(),
-						MTP_vector<MTPint>(mtpMsgIds),
-						MTP_vector<MTPlong>(randoms),
-						history->peer->input(),
-						MTP_int(realTopMsgId),
-						(sublistPeer
-							? MTP_inputReplyToMonoForum(
-								sublistPeer->input())
-							: MTPInputReplyTo()),
-						MTP_int(options.scheduled),
-						MTP_int(options.scheduleRepeatPeriod),
-						MTP_inputPeerEmpty(),
-						Data::ShortcutIdToMTP(
-							&history->session(),
-							options.shortcutId),
-						MTP_long(options.effectId),
-						MTP_int(videoTimestamp.value_or(0)),
-						MTP_long(starsPaid),
-						Api::SuggestToMTP(options.suggest));
-				};
-				const auto requestKey = ++state->nextRequestKey;
-				state->requests.insert(requestKey);
-				histories.sendPreparedMessage(
-					threadHistory,
-					FullReplyTo{ .topicRootId = topicRootId },
-					uint64(0),
-					std::move(buildMessage),
-					[=](const MTPUpdates &updates,
-							const MTP::Response &) {
-						requestDone(updates, requestKey);
-					},
-					[=](const MTP::Error &error,
-							const MTP::Response &) {
-						requestFail(error, requestKey);
-					});
-			}
+			for (const auto &range : ranges) {
+				const auto total = int(range.items.size());
+				for (auto batchStart = 0; batchStart < total;) {
+					auto batchEnd = std::min(
+						batchStart + maxForwardedPerRequest,
+						total);
+					if (batchEnd < total) {
+						if (const auto group = history->session().data().groups().find(
+								range.items[batchEnd]);
+							group
+							&& (group->items.front() != range.items[batchEnd])
+							&& (int(group->items.size()) <= maxForwardedPerRequest)) {
+							const auto groupFirst = ranges::find(
+								range.items,
+								group->items.front());
+							if (groupFirst != range.items.end()) {
+								const auto groupStart = int(
+									groupFirst - range.items.begin());
+								if (groupStart > batchStart) {
+									batchEnd = groupStart;
+								}
+							}
+						}
+					}
+					auto batchRange = range;
+					batchRange.items = std::vector<not_null<HistoryItem*>>(
+						range.items.begin() + batchStart,
+						range.items.begin() + batchEnd);
+					const auto mtpMsgIds = ForwardRangeIds(
+						&history->session(),
+						batchRange);
+					batchStart = batchEnd;
+					if (mtpMsgIds.isEmpty()) {
+						continue;
+					}
+					const auto msgCount = int(mtpMsgIds.size());
+					const auto starsPaid = std::min(
+						options.starsApproved,
+						msgCount * peer->starsPerMessageChecked());
+					if (starsPaid) {
+						options.starsApproved -= starsPaid;
+					}
+					const auto sendFlags = commonSendFlags
+						| (ShouldSendSilent(peer, options)
+							? Flag::f_silent
+							: Flag(0))
+						| (options.shortcutId
+							? Flag::f_quick_reply_shortcut
+							: Flag(0))
+						| (starsPaid ? Flag::f_allow_paid_stars : Flag())
+						| (sublistPeer ? Flag::f_reply_to : Flag())
+						| (options.suggest ? Flag::f_suggested_post : Flag())
+						| (options.effectId ? Flag::f_effect : Flag())
+						| (range.fromEphemeral
+							? Flag::f_from_ephemeral
+							: Flag(0));
+					auto buildMessage = [=](
+							not_null<History*> history,
+							FullReplyTo replyTo)
+						-> Data::Histories::PreparedMessage {
+						const auto kGeneralId
+							= Data::ForumTopic::kGeneralId;
+						const auto realTopMsgId
+							= (replyTo.topicRootId == kGeneralId)
+							? MsgId(0)
+							: replyTo.topicRootId;
+						auto flags = sendFlags;
+						if (realTopMsgId) {
+							flags |= Flag::f_top_msg_id;
+						} else {
+							flags &= ~Flag::f_top_msg_id;
+						}
+						auto randoms = QVector<MTPlong>(msgCount);
+						for (auto &value : randoms) {
+							value = base::RandomValue<MTPlong>();
+						}
+						return MTPmessages_ForwardMessages(
+							MTP_flags(flags),
+							fromPeer->input(),
+							MTP_vector<MTPint>(mtpMsgIds),
+							MTP_vector<MTPlong>(randoms),
+							history->peer->input(),
+							MTP_int(realTopMsgId),
+							(sublistPeer
+								? MTP_inputReplyToMonoForum(
+									sublistPeer->input())
+								: MTPInputReplyTo()),
+							MTP_int(options.scheduled),
+							MTP_int(options.scheduleRepeatPeriod),
+							MTP_inputPeerEmpty(),
+							Data::ShortcutIdToMTP(
+								&history->session(),
+								options.shortcutId),
+							MTP_long(options.effectId),
+							MTP_int(videoTimestamp.value_or(0)),
+							MTP_long(starsPaid),
+							Api::SuggestToMTP(options.suggest));
+					};
+					const auto requestKey = ++state->nextRequestKey;
+					state->requests.insert(requestKey);
+					histories.sendPreparedMessage(
+						threadHistory,
+						FullReplyTo{ .topicRootId = topicRootId },
+						uint64(0),
+						std::move(buildMessage),
+						[=](const MTPUpdates &updates,
+								const MTP::Response &) {
+							requestDone(updates, requestKey);
+						},
+						[=](const MTP::Error &error,
+								const MTP::Response &) {
+							requestFail(error, requestKey);
+						});
+				}
+			}
diff --git a/Telegram/SourceFiles/history/history_widget.cpp b/Telegram/SourceFiles/history/history_widget.cpp
